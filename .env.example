# 复制为 .env 后填写真实值

# PostgreSQL 连接串
DATABASE_URL="postgresql://clfp:你的密码@127.0.0.1:5432/clfp_dev?schema=public"

# 32 字节 base64 密钥，用于敏感字段加密
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# 登录态有效期（天）
SESSION_DAYS="30"

# ---- RAG 模型配置（全部留空时使用本地降级模式，无需任何 API Key）----
# 供应商：mock | openai | ollama
RAG_PROVIDER="mock"

# 向量模型（以火山方舟为例，OpenAI 兼容接口）
# RAG_EMBED_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# RAG_EMBED_API_KEY=""
# RAG_EMBED_MODEL="doubao-embedding-large-text-240915"
# RAG_EMBED_DIM="4096"

# 生成推荐理由的对话模型（可选）
# RAG_CHAT_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# RAG_CHAT_API_KEY=""
# RAG_CHAT_MODEL="doubao-seed-1-6-250615"

# worker 轮询间隔（毫秒）
WORKER_INTERVAL_MS="5000"
